# ================================================================
# 本地开发环境配置
# 复制此文件为 .env，按需填写
# Docker 部署请使用 .env.docker.example
# ================================================================

# [可选] development | production | test
NODE_ENV=development
# [可选] 本地监听端口
PORT=3000

# ── Admin ─────────────────────────────────────────────────────────
# [必填]
ADMIN_EMAIL=

# ── Database ─────────────────────────────────────────────────────
# [可选]
POSTGRES_HOST=localhost
# [可选]
POSTGRES_PORT=5432
# [可选]
POSTGRES_USER=qnya
# [必填]
POSTGRES_PASSWORD=
# [可选]
POSTGRES_DB=qnya
# [可选] 连接池最大连接数
DB_POOL_MAX=20
# [可选] 空闲连接超时 ms
DB_POOL_IDLE_TIMEOUT=30000
# [可选] 获取连接超时 ms
DB_POOL_CONNECTION_TIMEOUT=2000

# ── Redis ─────────────────────────────────────────────────────────
# [必填]
REDIS_URL=redis://localhost:6379

# ── Meilisearch（必选）───
# [必填] 未配置时应用无法启动
# 本地开发可用 Docker 启动：
#   docker run -d --name qnya-meili -p 7700:7700 \
#     -v meili_dev_data:/meili_data getmeili/meilisearch:v1.53.2
MEILI_URL=http://localhost:7700
# [可选] 服务端设置了 MEILI_MASTER_KEY 时必填，需保持一致
# MEILI_MASTER_KEY=

# ── Session ───────────────────────────────────────────────────────
# [必填]
SESSION_DOMAIN=localhost
# [必填]
SESSION_SECRET=
# [可选] session 有效期 ms，默认 7 天
SESSION_MAX_AGE=604800000
# [可选] 距过期多久内自动续期 ms，默认 1 天
SESSION_RENEW_THRESHOLD=86400000

# ── Security ──────────────────────────────────────────────────────
# [可选] 请求频率限制（每 IP）
RATE_LIMIT_MAX=100
# [可选] 允许的 CORS 来源，逗号分隔，留空则禁用
CORS_ORIGINS=

# ── SMTP ──────────────────────────────────────────────────────────
# [必填]
SMTP_HOST=
# [可选]
SMTP_PORT=465
# [可选]
SMTP_SECURE=true
# [必填]
SMTP_USER=
# [必填]
SMTP_PASS=
# [必填]
SMTP_FROM=

# ── qBittorrent ───────────────────────────────────────────────────
# [必填]
QBIT_HOST=http://localhost:8080
# [必填]
QBIT_USERNAME=
# [必填]
QBIT_PASSWORD=
# [必填] qBittorrent 容器内的下载目录
QBIT_DOWNLOAD_PATH=
# [可选] 宿主机下载目录（供 app 访问文件用）
QBIT_HOST_DOWNLOAD_PATH=
# [必填] Webhook 鉴权密钥
QBIT_WEBHOOK_SECRET=

# ── Resource ──────────────────────────────────────────────────────
# [必填] 媒体资源存储根目录
RESOURCE_ROOT_PATH=

# ── TMDB ──────────────────────────────────────────────────────────
# [必填] 不填则无法使用 TMDB 搜索功能
TMDB_API_KEY=
# [可选]
TMDB_IMAGE_DOMAIN=image.tmdb.org
# [可选]
TMDB_API_DOMAIN=api.themoviedb.org
