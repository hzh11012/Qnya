# ================================================================
# Qnya 环境配置（本地开发 / Docker 部署通用）
#
# 用法:复制此文件为 .env,按需填写
#   - 本地开发:保持默认连接地址(localhost),pnpm dev 启动
#   - Docker 部署:docker compose up -d --build,零参数。
#     compose 会自动把下方"连接类变量"覆盖为容器网络地址
#     (postgres/redis/meilisearch/qbit),无需修改
# ================================================================

# ── 必填(所有部署方式)───────────────────────────────────────────
# 种子管理员邮箱(首次启动自动创建)
ADMIN_EMAIL=
# 数据库密码(Docker 部署时同时用于初始化 postgres,务必强随机)
POSTGRES_PASSWORD=
# 会话签名密钥(至少 32 字符,可用: openssl rand -base64 32)
SESSION_SECRET=
# Webhook 鉴权密钥,qBittorrent 回调与应用共用
QBIT_WEBHOOK_SECRET=
# SMTP 邮箱(发送登录验证码)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# qBittorrent 登录账号(需与 qbit WebUI 中设置一致)
QBIT_USERNAME=
QBIT_PASSWORD=

# ── 应用 ─────────────────────────────────────────────────────────
# [可选] development | production
# 注意:production 下 session cookie 带 Secure 标记,需 HTTPS 才能登录;
# 局域网 HTTP 部署请用 development
NODE_ENV=development
# [可选] 应用监听端口(Docker 容器内由 compose 固定为 3000)
PORT=3000
# [可选] Docker 对外端口(仅宿主机映射,与上方 PORT 无关)
HTTP_PORT=5000
HTTP_ADMIN_PORT=5001
# [可选] MCP 接口鉴权 Bearer Token(留空则 MCP 接口拒绝所有请求)
MCP_TOKEN=

# ── Session ──────────────────────────────────────────────────────
# [可选] cookie 域(裸域名,如 qnya.cn,子域自动包含);
# 留空 = 仅当前主机生效(IP 访问或 localhost 开发均可)
SESSION_DOMAIN=
# [可选]
SESSION_MAX_AGE=604800000
SESSION_RENEW_THRESHOLD=86400000

# ── 安全 ─────────────────────────────────────────────────────────
# [可选] 请求频率限制(每 IP)
RATE_LIMIT_MAX=100
# [可选] 允许的 CORS 来源,逗号分隔;前后端同源部署留空即可
CORS_ORIGINS=

# ── Docker 挂载路径（仅 compose 读取，应用不使用）────────────────────
# 不填会静默回退到项目目录下的 ./data/...，导致 NFS 未挂载、文件树为空
# 宿主机资源库根目录（NFS 挂载点）→ 容器 /data/resources
HOST_RESOURCES_PATH=
# 宿主机 qbit 数据目录，其 downloads 子目录 → 容器 /downloads
QBIT_DATA_PATH=
# 示例（downloads 与 resources 在同一 NFS 文件系统内，入库 rename 秒完成）：
#   HOST_RESOURCES_PATH=/home/anime
#   QBIT_DATA_PATH=/home/anime

# ── 连接类变量 ────────────────────────────────────────────────
# Docker 部署:以下全部无需填写,compose 自动注入容器网络地址
# 本地开发:保持注释即使用代码默认值(localhost),与默认不一致时再取消注释修改
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=qnya
# POSTGRES_DB=qnya
# REDIS_URL=redis://localhost:6379
# MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=
# QBIT_HOST=http://localhost:8080

# 本地开发需手动填写(Docker 部署由 compose 注入,留空即可):
# qBittorrent 容器内下载目录 / 宿主机下载目录 / 媒体库根目录
QBIT_DOWNLOAD_PATH=
QBIT_HOST_DOWNLOAD_PATH=
RESOURCE_ROOT_PATH=

# ── 可选调优 ─────────────────────────────────────────────────────
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ── TMDB ─────────────────────────────────────────────────────────
# [必填] 不填则无法使用 TMDB 搜索功能
TMDB_API_KEY=
TMDB_IMAGE_DOMAIN=image.tmdb.org
TMDB_API_DOMAIN=api.themoviedb.org
