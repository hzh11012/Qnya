# ================================================================
# Docker 部署环境配置
# 复制此文件为 .env.docker，按需填写
# 启动命令：docker compose --env-file .env.docker up -d
# 本地开发请使用 .env.example
# ================================================================
# 以下连接类变量由 docker-compose 自动注入 app 容器，无需填写：
#   POSTGRES_HOST=postgres
#   REDIS_URL=redis://redis:6379
#   QBIT_HOST=http://qbit:8080
#   RESOURCE_ROOT_PATH=/data/resources
#   QBIT_DOWNLOAD_PATH=/downloads
#   QBIT_HOST_DOWNLOAD_PATH=/data/downloads
#   MEILI_URL=http://meilisearch:7700
# ================================================================

# ── Docker 基础设施 ───────────────────────────────────────────────
# [可选] app 对外端口
PORT=80
# [可选] 前端版本，留空使用 latest
FRONTEND_VERSION=
# [可选] Postgres 用户名
POSTGRES_USER=qnya
# [可选] Postgres 数据库名
POSTGRES_DB=qnya
# [可选] qBittorrent 数据目录（config + downloads）
QBIT_DATA_PATH=./data/qbit
# [可选] 媒体资源宿主机目录
HOST_RESOURCES_PATH=./data/resources
# [可选] qBittorrent WebUI 端口映射
QBIT_WEBUI_PORT=8080
# [可选] qBittorrent BT 端口映射
QBIT_BT_PORT=6881

# ── 密钥（必填）─────────────────────────────────────────────────
# [必填]
POSTGRES_PASSWORD=
# [必填] Webhook 鉴权密钥，qBittorrent 容器与 app 共用
QBIT_WEBHOOK_SECRET=

# ── App 配置 ─────────────────────────────────────────────────────
# [可选]
NODE_ENV=production

# [必填]
ADMIN_EMAIL=

# [可选] 连接池最大连接数
DB_POOL_MAX=20
# [可选] 空闲连接超时 ms
DB_POOL_IDLE_TIMEOUT=30000
# [可选] 获取连接超时 ms
DB_POOL_CONNECTION_TIMEOUT=2000

# [必填]
SESSION_DOMAIN=
# [必填]
SESSION_SECRET=
# [可选] session 有效期 ms，默认 7 天
SESSION_MAX_AGE=604800000
# [可选] 距过期多久内自动续期 ms，默认 1 天
SESSION_RENEW_THRESHOLD=86400000

# [可选] 需与 docker-compose 中 meilisearch 服务的 MEILI_MASTER_KEY 保持一致
# MEILI_MASTER_KEY=

# [可选] 请求频率限制（每 IP）
RATE_LIMIT_MAX=100
# [可选] 允许的 CORS 来源，逗号分隔，留空则禁用
CORS_ORIGINS=

# [必填]
SMTP_HOST=
# [可选]
SMTP_PORT=465
# [可选]
SMTP_SECURE=true
# [必填]
SMTP_USER=
# [必填]
SMTP_PASS=
# [必填]
SMTP_FROM=

# [必填]
QBIT_USERNAME=
# [必填]
QBIT_PASSWORD=

# [必填] 不填则无法使用 TMDB 搜索功能
TMDB_API_KEY=
# [可选]
TMDB_IMAGE_DOMAIN=image.tmdb.org
# [可选]
TMDB_API_DOMAIN=api.themoviedb.org
